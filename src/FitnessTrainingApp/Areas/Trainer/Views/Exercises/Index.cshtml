@model FitnessTrainingApp.Models.ViewModels.Trainer.TrainerExerciseIndexViewModel

@{
    ViewData["Title"] = L["Trainer Exercises"];
}

<section class="page-header">
    <div>
        <p class="eyebrow">@L["Trainer Area"]</p>
        <h1>@L["My Exercises"]</h1>
        <p class="lead">@L["Create and update exercise content before administrator moderation."]</p>
    </div>
    <a class="btn btn-primary align-self-start" asp-area="Trainer" asp-controller="Exercises" asp-action="Create">@L["Create exercise"]</a>
</section>

@if (Model.Exercises.Count == 0)
{
    <div class="empty-state">
        <h2>@L["No exercises yet"]</h2>
        <p>@L["Create the first exercise and submit it for moderation."]</p>
    </div>
}
else
{
    <section class="management-list" aria-label="@L["Trainer exercise list"]">
        @foreach (var exercise in Model.Exercises)
        {
            var statusClass = exercise.Status.ToString().ToLowerInvariant();

            <article class="management-row">
                <div>
                    <span class="status-badge status-badge-@statusClass">@exercise.Status</span>
                    <h2>@exercise.Name</h2>
                    <p>@exercise.WorkoutType - @exercise.Difficulty - @exercise.MuscleGroup</p>
                    @if (exercise.Status == FitnessTrainingApp.Models.Entities.Enums.ContentStatus.Rejected && !string.IsNullOrWhiteSpace(exercise.ModerationComment))
                    {
                        <p class="moderation-comment"><strong>@L["Admin comment"]:</strong> @exercise.ModerationComment</p>
                    }
                    <span class="playlist-meta">@L["Updated"] @exercise.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                </div>
                <div class="playlist-actions">
                    <a class="btn btn-outline-primary" asp-area="Trainer" asp-controller="Exercises" asp-action="Edit" asp-route-id="@exercise.Id">@L["Edit"]</a>
                    <form asp-area="Trainer" asp-controller="Exercises" asp-action="Delete" method="post">
                        <input type="hidden" name="id" value="@exercise.Id" />
                        <button type="submit" class="btn btn-outline-danger">@L["Delete"]</button>
                    </form>
                </div>
            </article>
        }
    </section>
}
