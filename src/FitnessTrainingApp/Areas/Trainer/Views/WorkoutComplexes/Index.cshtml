@model FitnessTrainingApp.Models.ViewModels.Trainer.TrainerWorkoutComplexIndexViewModel

@{
    ViewData["Title"] = L["Trainer Workout Complexes"];
}

<section class="page-header">
    <div>
        <p class="eyebrow">@L["Trainer Area"]</p>
        <h1>@L["My Workout Complexes"]</h1>
        <p class="lead">@L["Create structured workout plans from published exercises."]</p>
    </div>
    <a class="btn btn-primary align-self-start" asp-area="Trainer" asp-controller="WorkoutComplexes" asp-action="Create">@L["Create complex"]</a>
</section>

@if (Model.WorkoutComplexes.Count == 0)
{
    <div class="empty-state">
        <h2>@L["No workout complexes yet"]</h2>
        <p>@L["Create a plan and submit it for moderation."]</p>
    </div>
}
else
{
    <section class="management-list" aria-label="@L["Trainer workout complex list"]">
        @foreach (var complex in Model.WorkoutComplexes)
        {
            var statusClass = complex.Status.ToString().ToLowerInvariant();

            <article class="management-row">
                <div>
                    <span class="status-badge status-badge-@statusClass">@complex.Status</span>
                    <h2>@complex.Name</h2>
                    <p>@complex.WorkoutType - @complex.Difficulty - @complex.DurationMinutes @L["min"] - @L["Exercise count short", complex.ExerciseCount]</p>
                    @if (complex.Status == FitnessTrainingApp.Models.Entities.Enums.ContentStatus.Rejected && !string.IsNullOrWhiteSpace(complex.ModerationComment))
                    {
                        <p class="moderation-comment"><strong>@L["Admin comment"]:</strong> @complex.ModerationComment</p>
                    }
                    <span class="playlist-meta">@L["Updated"] @complex.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                </div>
                <div class="playlist-actions">
                    <a class="btn btn-outline-primary" asp-area="Trainer" asp-controller="WorkoutComplexes" asp-action="Details" asp-route-id="@complex.Id">@L["View exercises"]</a>
                    <form asp-area="Trainer" asp-controller="WorkoutComplexes" asp-action="Delete" method="post">
                        <input type="hidden" name="id" value="@complex.Id" />
                        <button type="submit" class="btn btn-outline-danger">@L["Delete"]</button>
                    </form>
                </div>
            </article>
        }
    </section>
}
