@model FitnessTrainingApp.Models.ViewModels.WorkoutComplexes.WorkoutComplexDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

<article class="exercise-details">
    <a class="back-link" asp-area="Trainer" asp-controller="WorkoutComplexes" asp-action="Index">@L["Back to complexes"]</a>

    <header class="details-header">
        <div>
            <p class="eyebrow">@Model.WorkoutType @L["workout"]</p>
            <h1>@Model.Name</h1>
            <p class="lead">@Model.Description</p>
        </div>
        <div class="details-rating">
            <span class="rating-value">@Model.DurationMinutes @L["min"]</span>
            <span>@Model.Difficulty</span>
            <span>@L["Exercise count short", Model.Exercises.Count]</span>
        </div>
    </header>

    <section class="details-layout">
        <div class="details-main">
            <h2>@L["Workout sequence"]</h2>
            <div class="workout-steps">
                @foreach (var item in Model.Exercises)
                {
                    <article class="workout-step">
                        <div class="step-number">@item.OrderNumber</div>
                        <div>
                            <h3>
                                <a asp-area="" asp-controller="Exercises" asp-action="Details" asp-route-id="@item.ExerciseId">@item.ExerciseName</a>
                            </h3>
                            <p>@item.MuscleGroup - @item.Equipment</p>
                        </div>
                        <div class="step-load">
                            <strong>@item.Sets</strong>
                            <span>@L["sets"]</span>
                            <strong>@item.Repetitions</strong>
                            <span>@L["reps"]</span>
                        </div>
                    </article>
                }
            </div>
        </div>

        <aside class="details-side">
            <h2>@L["Plan parameters"]</h2>
            <dl>
                <div>
                    <dt>@L["Difficulty"]</dt>
                    <dd>@Model.Difficulty</dd>
                </div>
                <div>
                    <dt>@L["Workout type"]</dt>
                    <dd>@Model.WorkoutType</dd>
                </div>
                <div>
                    <dt>@L["Duration"]</dt>
                    <dd>@Model.DurationMinutes @L["min"]</dd>
                </div>
                <div>
                    <dt>@L["Exercises"]</dt>
                    <dd>@Model.Exercises.Count</dd>
                </div>
            </dl>
        </aside>
    </section>
</article>
