@model FitnessTrainingApp.Models.ViewModels.Admin.AdminLogIndexViewModel

@{
    ViewData["Title"] = L["Admin Logs"];
}

<section class="page-header">
    <div>
        <p class="eyebrow">@L["Admin Area"]</p>
        <h1>@L["Admin Logs"]</h1>
        <p class="lead">@L["Review moderation and role-management actions performed by administrators."]</p>
    </div>
</section>

@if (Model.Logs.Count == 0)
{
    <div class="empty-state">
        <h2>@L["No admin actions yet"]</h2>
        <p>@L["Moderation and user role changes will appear here."]</p>
    </div>
}
else
{
    <section class="log-table" aria-label="@L["Admin action log"]">
        <div class="log-row log-header">
            <span>@L["Date"]</span>
            <span>@L["Admin"]</span>
            <span>@L["Action"]</span>
            <span>@L["Entity"]</span>
            <span>@L["Target"]</span>
        </div>
        @foreach (var log in Model.Logs)
        {
            <article class="log-row">
                <span>@log.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                <span>@log.AdminName</span>
                <span>@log.Action</span>
                <span>@log.EntityName #@log.EntityId</span>
                <span>@(log.TargetUserId.HasValue ? $"User #{log.TargetUserId}" : "-")</span>
            </article>
        }
    </section>
}
