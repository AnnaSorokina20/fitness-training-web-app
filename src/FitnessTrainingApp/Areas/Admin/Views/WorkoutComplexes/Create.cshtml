@model FitnessTrainingApp.Models.ViewModels.Trainer.TrainerWorkoutComplexFormViewModel
@using FitnessTrainingApp.Models.Entities.Enums

@{
    ViewData["Title"] = L["Create Workout Complex"];
}

<section class="page-header">
    <div>
        <p class="eyebrow">@L["Admin Area"]</p>
        <h1>@L["Create Workout Complex"]</h1>
        <p class="lead">@L["Workout complexes created by an administrator are published immediately."]</p>
    </div>
</section>

<form method="post" class="management-form">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-grid">
        <div class="form-field form-field-wide">
            <label asp-for="Name"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-field">
            <label asp-for="Difficulty"></label>
            <select asp-for="Difficulty" class="form-select" asp-items="Html.GetEnumSelectList<DifficultyLevel>()"></select>
            <span asp-validation-for="Difficulty" class="text-danger"></span>
        </div>

        <div class="form-field">
            <label asp-for="WorkoutType">@L["Workout type"]</label>
            <select asp-for="WorkoutType" class="form-select" asp-items="Html.GetEnumSelectList<WorkoutType>()"></select>
            <span asp-validation-for="WorkoutType" class="text-danger"></span>
        </div>

        <div class="form-field">
            <label asp-for="DurationMinutes"></label>
            <input asp-for="DurationMinutes" class="form-control" />
            <span asp-validation-for="DurationMinutes" class="text-danger"></span>
        </div>

        <div class="form-field form-field-wide">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" class="form-control" rows="5"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
    </div>

    <section class="exercise-picker" data-exercise-picker>
        <div class="exercise-picker-header">
            <h2>@L["Exercises"]</h2>
            <button type="button" class="btn btn-outline-primary" data-add-exercise>@L["Add exercise"]</button>
        </div>
        <div data-exercise-list>
            @for (var i = 0; i < Model.Exercises.Count; i++)
            {
                <div class="exercise-picker-row" data-exercise-row>
                    <div class="exercise-picker-title">@L["Exercise"] @(i + 1)</div>
                    <button type="button" class="btn btn-outline-danger exercise-remove" data-remove-exercise>@L["Remove"]</button>

                    <div class="form-field">
                        <label asp-for="Exercises[i].ExerciseId">@L["Exercise"]</label>
                        <select asp-for="Exercises[i].ExerciseId" class="form-select" asp-items="Model.ExerciseOptions">
                            <option value="0">@L["Not selected"]</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label asp-for="Exercises[i].Sets"></label>
                        <input asp-for="Exercises[i].Sets" class="form-control" />
                        <span asp-validation-for="Exercises[i].Sets" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="Exercises[i].Repetitions"></label>
                        <input asp-for="Exercises[i].Repetitions" class="form-control" />
                        <span asp-validation-for="Exercises[i].Repetitions" class="text-danger"></span>
                    </div>
                </div>
            }
        </div>

        <template data-exercise-template>
            <div class="exercise-picker-row" data-exercise-row>
                <div class="exercise-picker-title">@L["Exercise"] __NUMBER__</div>
                <button type="button" class="btn btn-outline-danger exercise-remove" data-remove-exercise>@L["Remove"]</button>

                <div class="form-field">
                    <label for="Exercises___INDEX____ExerciseId">@L["Exercise"]</label>
                    <select id="Exercises___INDEX____ExerciseId" name="Exercises[__INDEX__].ExerciseId" class="form-select">
                        <option value="0">@L["Not selected"]</option>
                        @foreach (var option in Model.ExerciseOptions)
                        {
                            <option value="@option.Value">@option.Text</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label for="Exercises___INDEX____Sets">@L["sets"]</label>
                    <input id="Exercises___INDEX____Sets" name="Exercises[__INDEX__].Sets" class="form-control" type="number" value="3" min="1" max="20" />
                </div>
                <div class="form-field">
                    <label for="Exercises___INDEX____Repetitions">@L["Repetitions"]</label>
                    <input id="Exercises___INDEX____Repetitions" name="Exercises[__INDEX__].Repetitions" class="form-control" type="number" value="10" min="1" max="100" />
                </div>
            </div>
        </template>
    </section>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">@L["Publish"]</button>
        <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Moderation" asp-action="Index">@L["Cancel"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/workout-complex-form.js" asp-append-version="true"></script>
}
