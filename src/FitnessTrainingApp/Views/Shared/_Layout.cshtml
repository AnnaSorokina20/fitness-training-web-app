<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fitness Training</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FitnessTrainingApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Fitness Training</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Exercises" asp-action="Index">Exercises</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="WorkoutComplexes" asp-action="Index">Workout Complexes</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Playlist" asp-action="Index">My Playlist</a>
                            </li>
                        }
                        @if (User.IsInRole("Trainer"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Trainer" asp-controller="Exercises" asp-action="Index">Trainer Exercises</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Trainer" asp-controller="WorkoutComplexes" asp-action="Index">Trainer Complexes</a>
                            </li>
                        }
                        @if (User.IsInRole("Administrator"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Admin" asp-controller="Moderation" asp-action="Index">Moderation</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Admin" asp-controller="Users" asp-action="Index">Users</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Admin" asp-controller="AdminLogs" asp-action="Index">Logs</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav account-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="navbar-text text-dark">@User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="nav-form">
                                    <button type="submit" class="nav-link nav-button">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Login">Log in</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-main">
                <div class="footer-brand-block">
                    <a class="footer-brand" asp-area="" asp-controller="Home" asp-action="Index">Fitness Training</a>
                    <p>Exercise catalog and structured workout plans for home and gym training.</p>
                </div>

                <nav class="footer-links" aria-label="Footer navigation">
                    <h2>Catalog</h2>
                    <a asp-area="" asp-controller="Exercises" asp-action="Index">Exercises</a>
                    <a asp-area="" asp-controller="WorkoutComplexes" asp-action="Index">Workout Complexes</a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-area="" asp-controller="Playlist" asp-action="Index">My Playlist</a>
                    }
                </nav>

                <nav class="footer-links" aria-label="Footer account navigation">
                    <h2>Account</h2>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span>@User.Identity.Name</span>
                        @if (User.IsInRole("Trainer"))
                        {
                            <a asp-area="Trainer" asp-controller="Exercises" asp-action="Index">Trainer Area</a>
                        }
                        @if (User.IsInRole("Administrator"))
                        {
                            <a asp-area="Admin" asp-controller="Moderation" asp-action="Index">Admin Area</a>
                        }
                    }
                    else
                    {
                        <a asp-area="" asp-controller="Account" asp-action="Login">Log in</a>
                        <a asp-area="" asp-controller="Account" asp-action="Register">Register</a>
                    }
                </nav>
            </div>

            <div class="footer-bottom">
                <span>&copy; 2026 Fitness Training</span>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
