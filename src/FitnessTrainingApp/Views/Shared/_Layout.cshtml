<!DOCTYPE html>
@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;
}
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @L["Fitness Training"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FitnessTrainingApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">@L["Fitness Training"]</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">@L["Home"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Exercises" asp-action="Index">@L["Exercises"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="WorkoutComplexes" asp-action="Index">@L["Workout Complexes"]</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Playlist" asp-action="Index">@L["My Playlist"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Profile">@L["Profile"]</a>
                            </li>
                        }
                        @if (User.IsInRole("Trainer"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Trainer" asp-controller="Exercises" asp-action="Index">@L["Trainer Exercises"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Trainer" asp-controller="WorkoutComplexes" asp-action="Index">@L["Trainer Complexes"]</a>
                            </li>
                        }
                        @if (User.IsInRole("Administrator"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Admin" asp-controller="Moderation" asp-action="Index">@L["Moderation"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Admin" asp-controller="Users" asp-action="Index">@L["Users"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Admin" asp-controller="AdminLogs" asp-action="Index">@L["Logs"]</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav account-nav">
                        <li class="nav-item">
                            <form asp-area="" asp-controller="Localization" asp-action="SetLanguage" method="post" class="language-switcher">
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button type="submit" name="culture" value="en" class="language-option @(currentCulture == "en" ? "active" : "")">EN</button>
                                <span class="language-divider">/</span>
                                <button type="submit" name="culture" value="uk" class="language-option @(currentCulture == "uk" ? "active" : "")">UA</button>
                            </form>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="navbar-text text-dark">@User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="nav-form">
                                    <button type="submit" class="nav-link nav-button">@L["Logout"]</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Login">@L["Log in"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Register">@L["Register"]</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-main">
                <div class="footer-brand-block">
                    <a class="footer-brand" asp-area="" asp-controller="Home" asp-action="Index">@L["Fitness Training"]</a>
                    <p>@L["Exercise catalog and structured workout plans for home and gym training."]</p>
                </div>

                <nav class="footer-links" aria-label="Footer navigation">
                    <h2>@L["Catalog"]</h2>
                    <a asp-area="" asp-controller="Exercises" asp-action="Index">@L["Exercises"]</a>
                    <a asp-area="" asp-controller="WorkoutComplexes" asp-action="Index">@L["Workout Complexes"]</a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-area="" asp-controller="Playlist" asp-action="Index">@L["My Playlist"]</a>
                    }
                </nav>

                <nav class="footer-links" aria-label="Footer account navigation">
                    <h2>@L["Account"]</h2>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span>@User.Identity.Name</span>
                        <a asp-area="" asp-controller="Account" asp-action="Profile">@L["Profile"]</a>
                        @if (User.IsInRole("Trainer"))
                        {
                            <a asp-area="Trainer" asp-controller="Exercises" asp-action="Index">@L["Trainer Area"]</a>
                        }
                        @if (User.IsInRole("Administrator"))
                        {
                            <a asp-area="Admin" asp-controller="Moderation" asp-action="Index">@L["Admin Area"]</a>
                        }
                    }
                    else
                    {
                        <a asp-area="" asp-controller="Account" asp-action="Login">@L["Log in"]</a>
                        <a asp-area="" asp-controller="Account" asp-action="Register">@L["Register"]</a>
                    }
                </nav>
            </div>

            <div class="footer-bottom">
                <span>&copy; 2026 @L["Fitness Training"]</span>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
