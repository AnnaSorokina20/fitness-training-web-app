@model FitnessTrainingApp.Models.ViewModels.Shared.PaginationViewModel

@{
    var routeValues = new Dictionary<string, string>(Model.RouteValues);
    routeValues["pageSize"] = Model.PageSize.ToString();
}

@if (Model.TotalItems > 0)
{
    <nav class="pagination-panel" aria-label="@L["Pagination"]">
        <div class="page-size-form">
            <span>@L["Show"]</span>
            @foreach (var size in Model.PageSizeOptions)
            {
                var sizeRouteValues = new Dictionary<string, string>(Model.RouteValues)
                {
                    ["page"] = "1",
                    ["pageSize"] = size.ToString()
                };

                <a class="page-size-link @(Model.PageSize == size ? "active" : string.Empty)"
                   asp-controller="@Model.ControllerName"
                   asp-action="@Model.ActionName"
                   asp-all-route-data="sizeRouteValues">@size</a>
            }
        </div>

        <div class="page-links">
            @{
                routeValues["page"] = (Model.CurrentPage - 1).ToString();
            }
            <a class="page-link-button @(Model.HasPreviousPage ? string.Empty : "disabled")"
               asp-controller="@Model.ControllerName"
               asp-action="@Model.ActionName"
               asp-all-route-data="routeValues">@L["Previous"]</a>

            <span>@L["Page of", Model.CurrentPage, Model.TotalPages]</span>

            @{
                routeValues["page"] = (Model.CurrentPage + 1).ToString();
            }
            <a class="page-link-button @(Model.HasNextPage ? string.Empty : "disabled")"
               asp-controller="@Model.ControllerName"
               asp-action="@Model.ActionName"
               asp-all-route-data="routeValues">@L["Next"]</a>
        </div>
    </nav>
}
