@model FitnessTrainingApp.Models.ViewModels.Home.HomeIndexViewModel

@{
    ViewData["Title"] = L["Fitness Training"];
}

<section class="home-hero">
    <div class="home-hero-content">
        <p class="eyebrow">@L["Fitness training web app"]</p>
        <h1>@L["Plan workouts for home and gym training"]</h1>
        <p class="lead">@L["Browse exercises, review structured workout complexes, and save useful training content in a personal playlist."]</p>
        <div class="hero-actions">
            <a class="btn btn-primary btn-lg" asp-controller="Exercises" asp-action="Index">@L["Browse exercises"]</a>
            <a class="btn btn-outline-primary btn-lg" asp-controller="WorkoutComplexes" asp-action="Index">@L["View complexes"]</a>
        </div>
    </div>
    <div class="home-hero-panel" aria-label="Project metrics">
        <div>
            <strong>@Model.ExerciseCount</strong>
            <span>@L["Exercises"]</span>
        </div>
        <div>
            <strong>@Model.WorkoutComplexCount</strong>
            <span>@L["Complexes"]</span>
        </div>
        <div>
            <strong>@Model.HomeWorkoutCount</strong>
            <span>@L["Home"]</span>
        </div>
        <div>
            <strong>@Model.GymWorkoutCount</strong>
            <span>@L["Gym"]</span>
        </div>
    </div>
</section>

<section class="home-section">
    <div class="section-title-row">
        <div>
            <p class="eyebrow">@L["Exercise library"]</p>
            <h2>@L["Featured exercises"]</h2>
        </div>
        <a asp-controller="Exercises" asp-action="Index">@L["Open catalog"]</a>
    </div>

    <div class="exercise-grid">
        @foreach (var exercise in Model.FeaturedExercises)
        {
            <article class="exercise-card">
                <div class="exercise-card-media">
                    @if (!string.IsNullOrWhiteSpace(exercise.ThumbnailUrl))
                    {
                        <img src="@exercise.ThumbnailUrl" alt="@exercise.Name" loading="lazy" />
                    }
                    else
                    {
                        <span>@exercise.MuscleGroup</span>
                    }
                </div>
                <div class="exercise-card-meta">
                    <span>@exercise.WorkoutType</span>
                    <span>@exercise.Difficulty</span>
                </div>
                <h2>@exercise.Name</h2>
                <p>@exercise.Description</p>
                <dl>
                    <div>
                        <dt>@L["Muscle group"]</dt>
                        <dd>@exercise.MuscleGroup</dd>
                    </div>
                    <div>
                        <dt>@L["Equipment"]</dt>
                        <dd>@exercise.Equipment</dd>
                    </div>
                </dl>
                <a class="btn btn-outline-primary" asp-controller="Exercises" asp-action="Details" asp-route-id="@exercise.Id">@L["View details"]</a>
            </article>
        }
    </div>
</section>

<section class="home-section">
    <div class="section-title-row">
        <div>
            <p class="eyebrow">@L["Training plans"]</p>
            <h2>@L["Ready workout complexes"]</h2>
        </div>
        <a asp-controller="WorkoutComplexes" asp-action="Index">@L["Open complexes"]</a>
    </div>

    <div class="complex-preview-grid">
        @foreach (var complex in Model.FeaturedComplexes)
        {
            <article class="complex-preview">
                <div>
                    <div class="exercise-card-meta">
                        <span>@complex.WorkoutType</span>
                        <span>@complex.Difficulty</span>
                    </div>
                    <h3>@complex.Name</h3>
                    <p>@complex.Description</p>
                </div>
                <dl>
                    <div>
                        <dt>@L["Duration"]</dt>
                        <dd>@complex.DurationMinutes @L["min"]</dd>
                    </div>
                    <div>
                        <dt>@L["Exercises"]</dt>
                        <dd>@complex.ExerciseCount</dd>
                    </div>
                </dl>
                <a class="btn btn-outline-primary" asp-controller="WorkoutComplexes" asp-action="Details" asp-route-id="@complex.Id">@L["View plan"]</a>
            </article>
        }
    </div>
</section>
