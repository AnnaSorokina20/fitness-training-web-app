@model FitnessTrainingApp.Models.ViewModels.Exercises.ExerciseDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

<article class="exercise-details">
    <a class="back-link" href="@Model.BackUrl">@L[Model.BackLabel]</a>

    <header class="details-header">
        <div>
            <p class="eyebrow">@Model.WorkoutType @L["workout"]</p>
            <h1>@Model.Name</h1>
            <p class="author-line">@L["Trainer"]: @Model.TrainerName</p>
            <p class="lead">@Model.Description</p>
        </div>
        <div class="details-rating">
            <span class="rating-value">@(Model.RatingCount == 0 ? L["No ratings"] : Model.AverageRating.ToString("0.0"))</span>
            <span>@L["Ratings count", Model.RatingCount]</span>
            <span>@L["Comments count", Model.CommentCount]</span>
        </div>
    </header>

    @if (User.Identity?.IsAuthenticated == true)
    {
        @if (Model.PlaylistItemId.HasValue)
        {
            <form asp-controller="Playlist" asp-action="Remove" method="post" class="details-action-form">
                <input type="hidden" name="id" value="@Model.PlaylistItemId.Value" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <button type="submit" class="btn btn-outline-danger">@L["Remove from playlist"]</button>
            </form>
        }
        else
        {
            <form asp-controller="Playlist" asp-action="AddExercise" method="post" class="details-action-form">
                <input type="hidden" name="exerciseId" value="@Model.Id" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <button type="submit" class="btn btn-primary">@L["Save to playlist"]</button>
            </form>
        }
    }
    else
    {
        <div class="signin-note">
            <a asp-area="" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString">@L["Log in"]</a> @L["to save this exercise to your playlist."]
        </div>
    }

    <section class="details-layout">
        <div class="details-main">
            @if (Model.MediaUrls.Count == 0)
            {
                <div class="media-placeholder">@L["Media will be added by the trainer."]</div>
            }
            else
            {
                <partial name="_MediaGallery" model="Model.MediaUrls" />
            }

            <h2>@L["Safety notes"]</h2>
            <p>@Model.SafetyNotes</p>

            <section class="interaction-section">
                <h2>@L["Ratings and comments"]</h2>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Exercises" asp-action="Rate" method="post" class="rating-form">
                        <input type="hidden" name="exerciseId" value="@Model.Id" />
                        @if (Model.HasCustomBackUrl)
                        {
                            <input type="hidden" name="returnUrl" value="@Model.BackUrl" />
                        }
                        <span class="rating-label">@L["Your rating"]</span>
                        <div class="star-rating" aria-label="@L["Your rating"]">
                            @for (var value = 5; value >= 1; value--)
                            {
                                var isSelected = Model.UserRating.HasValue && value <= Model.UserRating.Value;
                                <button type="submit" name="value" value="@value" class="star-button @(isSelected ? "star-button-selected" : string.Empty)" title="@L["Stars title", value]" aria-label="@L["Rate stars", value]">&#9733;</button>
                            }
                        </div>
                    </form>

                    <form asp-controller="Exercises" asp-action="AddComment" method="post" class="comment-form">
                        <input type="hidden" name="exerciseId" value="@Model.Id" />
                        @if (Model.HasCustomBackUrl)
                        {
                            <input type="hidden" name="returnUrl" value="@Model.BackUrl" />
                        }
                        <label for="commentText">@L["Comment"]</label>
                        <textarea id="commentText" name="text" class="form-control" rows="4" maxlength="1000" required></textarea>
                        <button type="submit" class="btn btn-primary">@L["Add comment"]</button>
                    </form>
                }
                else
                {
                    <div class="signin-note">
                        <a asp-area="" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString">@L["Log in"]</a> @L["to rate and comment on this exercise."]
                    </div>
                }

                @if (Model.Comments.Count == 0)
                {
                    <p class="muted-text">@L["No comments yet."]</p>
                }
                else
                {
                    <div class="comment-list">
                        @foreach (var comment in Model.Comments)
                        {
                            <article class="comment-item">
                                <div>
                                    <strong>@comment.AuthorName</strong>
                                    <span>@comment.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                                </div>
                                <p>@comment.Text</p>
                            </article>
                        }
                    </div>
                }
            </section>
        </div>

        <aside class="details-side">
            <h2>@L["Parameters"]</h2>
            <dl>
                <div>
                    <dt>@L["Difficulty"]</dt>
                    <dd>@Model.Difficulty</dd>
                </div>
                <div>
                    <dt>@L["Workout type"]</dt>
                    <dd>@Model.WorkoutType</dd>
                </div>
                <div>
                    <dt>@L["Equipment"]</dt>
                    <dd>@Model.Equipment</dd>
                </div>
                <div>
                    <dt>@L["Muscle group"]</dt>
                    <dd>@Model.MuscleGroup</dd>
                </div>
            </dl>
        </aside>
    </section>
</article>
