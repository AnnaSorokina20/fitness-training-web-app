@model FitnessTrainingApp.Models.ViewModels.Exercises.ExerciseCatalogViewModel
@using FitnessTrainingApp.Models.Entities.Enums

@{
    ViewData["Title"] = L["Exercise Catalog"];
}

<section class="page-header">
    <div>
        <p class="eyebrow">@L["Training content"]</p>
        <h1>@L["Exercise Catalog"]</h1>
        <p class="lead">@L["Find exercises for home and gym workouts by difficulty, equipment, and muscle group."]</p>
    </div>
</section>

<form class="catalog-filter" method="get" asp-controller="Exercises" asp-action="Index">
    <input type="hidden" name="pageSize" value="@Model.Exercises.Pagination.PageSize" />

    <div class="filter-field filter-field-wide">
        <label asp-for="Search">@L["Search"]</label>
        <div class="autocomplete-field" data-autocomplete-url="@Url.Action("Suggest", "Exercises")">
            <input asp-for="Search" class="form-control" placeholder="@L["Name, muscle group, equipment"]" autocomplete="off" data-autocomplete-input />
            <div class="autocomplete-list" data-autocomplete-list hidden></div>
        </div>
    </div>

    <div class="filter-field">
        <label asp-for="Difficulty">@L["Difficulty"]</label>
        <select asp-for="Difficulty" class="form-select" asp-items="Html.GetEnumSelectList<DifficultyLevel>()">
            <option value="">@L["Any"]</option>
        </select>
    </div>

    <div class="filter-field">
        <label asp-for="WorkoutType">@L["Workout type"]</label>
        <select asp-for="WorkoutType" class="form-select" asp-items="Html.GetEnumSelectList<WorkoutType>()">
            <option value="">@L["Any"]</option>
        </select>
    </div>

    <div class="filter-field">
        <label asp-for="Equipment">@L["Equipment"]</label>
        <input asp-for="Equipment" class="form-control" placeholder="@L["Barbell, mat..."]" />
    </div>

    <div class="filter-field">
        <label asp-for="MuscleGroup">@L["Muscle group"]</label>
        <input asp-for="MuscleGroup" class="form-control" placeholder="@L["Chest, legs..."]" />
    </div>

    <div class="filter-actions">
        <button type="submit" class="btn btn-primary">@L["Apply"]</button>
        <a class="btn btn-outline-secondary" asp-controller="Exercises" asp-action="Index">@L["Reset"]</a>
    </div>
</form>

<section class="catalog-summary" aria-label="Catalog summary">
    <span>@L["Exercises found", Model.Exercises.Pagination.TotalItems]</span>
</section>

@if (Model.Exercises.Pagination.TotalItems == 0)
{
    <div class="empty-state">
        <h2>@L["No exercises found"]</h2>
        <p>@L["Try changing the search query or removing one of the filters."]</p>
    </div>
}
else
{
    <section class="exercise-grid" aria-label="Exercise list">
        @foreach (var exercise in Model.Exercises.Items)
        {
            <article class="exercise-card">
                <div class="exercise-card-media">
                    @if (!string.IsNullOrWhiteSpace(exercise.ThumbnailUrl))
                    {
                        <img src="@exercise.ThumbnailUrl" alt="@exercise.Name" loading="lazy" />
                    }
                    else
                    {
                        <span>@exercise.MuscleGroup</span>
                    }
                </div>
                <div class="exercise-card-meta">
                    <span>@exercise.WorkoutType</span>
                    <span>@exercise.Difficulty</span>
                </div>
                <h2>@exercise.Name</h2>
                <p>@exercise.Description</p>
                <dl>
                    <div>
                        <dt>@L["Muscle group"]</dt>
                        <dd>@exercise.MuscleGroup</dd>
                    </div>
                    <div>
                        <dt>@L["Equipment"]</dt>
                        <dd>@exercise.Equipment</dd>
                    </div>
                </dl>
                <a class="btn btn-outline-primary" asp-controller="Exercises" asp-action="Details" asp-route-id="@exercise.Id">@L["View details"]</a>
            </article>
        }
    </section>

    <partial name="_Pagination" model="Model.Exercises.Pagination" />
}
