@model FitnessTrainingApp.Models.ViewModels.WorkoutComplexes.WorkoutComplexDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

<article class="exercise-details">
    <a class="back-link" asp-controller="WorkoutComplexes" asp-action="Index">@L["Back to complexes"]</a>

    <header class="details-header">
        <div>
            <p class="eyebrow">@Model.WorkoutType @L["workout"]</p>
            <h1>@Model.Name</h1>
            <p class="lead">@Model.Description</p>
        </div>
        <div class="details-rating">
            <span class="rating-value">@Model.DurationMinutes @L["min"]</span>
            <span>@Model.Difficulty</span>
            <span>@(Model.RatingCount == 0 ? L["No ratings"] : L["Average rating", Model.AverageRating.ToString("0.0")])</span>
            <span>@L["Votes count", Model.RatingCount]</span>
            <span>@L["Comments count", Model.CommentCount]</span>
        </div>
    </header>

    @if (User.Identity?.IsAuthenticated == true)
    {
        @if (Model.PlaylistItemId.HasValue)
        {
            <form asp-controller="Playlist" asp-action="Remove" method="post" class="details-action-form">
                <input type="hidden" name="id" value="@Model.PlaylistItemId.Value" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <button type="submit" class="btn btn-outline-danger">@L["Remove from playlist"]</button>
            </form>
        }
        else
        {
            <form asp-controller="Playlist" asp-action="AddWorkoutComplex" method="post" class="details-action-form">
                <input type="hidden" name="workoutComplexId" value="@Model.Id" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <button type="submit" class="btn btn-primary">@L["Save to playlist"]</button>
            </form>
        }
    }
    else
    {
        <div class="signin-note">
            <a asp-area="" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString">@L["Log in"]</a> @L["to save and rate this workout complex."]
        </div>
    }

    @if (User.Identity?.IsAuthenticated == true)
    {
        <form asp-controller="WorkoutComplexes" asp-action="Rate" method="post" class="rating-form">
            <input type="hidden" name="workoutComplexId" value="@Model.Id" />
            <span class="rating-label">@L["Your rating"]</span>
            <div class="star-rating" aria-label="@L["Your rating"]">
                @for (var value = 5; value >= 1; value--)
                {
                    var isSelected = Model.UserRating.HasValue && value <= Model.UserRating.Value;
                    <button type="submit" name="value" value="@value" class="star-button @(isSelected ? "star-button-selected" : string.Empty)" title="@L["Stars title", value]" aria-label="@L["Rate stars", value]">&#9733;</button>
                }
            </div>
        </form>
    }

    <section class="details-layout">
        <div class="details-main">
            <h2>@L["Workout sequence"]</h2>
            <div class="workout-steps">
                @foreach (var item in Model.Exercises)
                {
                    <article class="workout-step">
                        <div class="step-number">@item.OrderNumber</div>
                        <div>
                            <h3>
                                <a asp-controller="Exercises" asp-action="Details" asp-route-id="@item.ExerciseId">@item.ExerciseName</a>
                            </h3>
                            <p>@item.MuscleGroup · @item.Equipment</p>
                        </div>
                        <div class="step-load">
                            <strong>@item.Sets</strong>
                            <span>@L["sets"]</span>
                            <strong>@item.Repetitions</strong>
                            <span>@L["reps"]</span>
                        </div>
                    </article>
                }
            </div>

            <section class="interaction-section">
                <h2>@L["Comments"]</h2>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="WorkoutComplexes" asp-action="AddComment" method="post" class="comment-form">
                        <input type="hidden" name="workoutComplexId" value="@Model.Id" />
                        <label for="complexCommentText">@L["Comment"]</label>
                        <textarea id="complexCommentText" name="text" class="form-control" rows="4" maxlength="1000" required></textarea>
                        <button type="submit" class="btn btn-primary">@L["Add comment"]</button>
                    </form>
                }
                else
                {
                    <div class="signin-note">
                        <a asp-area="" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString">@L["Log in"]</a> @L["to comment on this workout complex."]
                    </div>
                }

                @if (Model.Comments.Count == 0)
                {
                    <p class="muted-text">@L["No comments yet."]</p>
                }
                else
                {
                    <div class="comment-list">
                        @foreach (var comment in Model.Comments)
                        {
                            <article class="comment-item">
                                <div>
                                    <strong>@comment.AuthorName</strong>
                                    <span>@comment.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                                </div>
                                <p>@comment.Text</p>
                            </article>
                        }
                    </div>
                }
            </section>
        </div>

        <aside class="details-side">
            <h2>@L["Plan parameters"]</h2>
            <dl>
                <div>
                    <dt>@L["Difficulty"]</dt>
                    <dd>@Model.Difficulty</dd>
                </div>
                <div>
                    <dt>@L["Workout type"]</dt>
                    <dd>@Model.WorkoutType</dd>
                </div>
                <div>
                    <dt>@L["Duration"]</dt>
                    <dd>@Model.DurationMinutes @L["min"]</dd>
                </div>
                <div>
                    <dt>@L["Exercises"]</dt>
                    <dd>@Model.Exercises.Count</dd>
                </div>
            </dl>
        </aside>
    </section>
</article>
