@model FitnessTrainingApp.Models.ViewModels.WorkoutComplexes.WorkoutComplexDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

<article class="exercise-details">
    <a class="back-link" asp-controller="WorkoutComplexes" asp-action="Index">Back to complexes</a>

    <header class="details-header">
        <div>
            <p class="eyebrow">@Model.WorkoutType workout</p>
            <h1>@Model.Name</h1>
            <p class="lead">@Model.Description</p>
        </div>
        <div class="details-rating">
            <span class="rating-value">@Model.DurationMinutes min</span>
            <span>@Model.Difficulty</span>
            <span>@(Model.RatingCount == 0 ? "No ratings" : $"{Model.AverageRating:0.0} rating")</span>
            <span>@Model.RatingCount vote@(Model.RatingCount == 1 ? "" : "s")</span>
        </div>
    </header>

    @if (User.Identity?.IsAuthenticated == true)
    {
        @if (Model.PlaylistItemId.HasValue)
        {
            <form asp-controller="Playlist" asp-action="Remove" method="post" class="details-action-form">
                <input type="hidden" name="id" value="@Model.PlaylistItemId.Value" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <button type="submit" class="btn btn-outline-danger">Remove from playlist</button>
            </form>
        }
        else
        {
            <form asp-controller="Playlist" asp-action="AddWorkoutComplex" method="post" class="details-action-form">
                <input type="hidden" name="workoutComplexId" value="@Model.Id" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <button type="submit" class="btn btn-primary">Save to playlist</button>
            </form>
        }
    }
    else
    {
        <div class="signin-note">
            <a asp-area="" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString">Log in</a> to save and rate this workout complex.
        </div>
    }

    @if (User.Identity?.IsAuthenticated == true)
    {
        <form asp-controller="WorkoutComplexes" asp-action="Rate" method="post" class="rating-form">
            <input type="hidden" name="workoutComplexId" value="@Model.Id" />
            <span class="rating-label">Your rating</span>
            <div class="star-rating" aria-label="Your rating">
                @for (var value = 5; value >= 1; value--)
                {
                    var isSelected = Model.UserRating.HasValue && value <= Model.UserRating.Value;
                    <button type="submit" name="value" value="@value" class="star-button @(isSelected ? "star-button-selected" : string.Empty)" title="@value star@(value == 1 ? "" : "s")" aria-label="Rate @value star@(value == 1 ? "" : "s")">&#9733;</button>
                }
            </div>
        </form>
    }

    <section class="details-layout">
        <div class="details-main">
            <h2>Workout sequence</h2>
            <div class="workout-steps">
                @foreach (var item in Model.Exercises)
                {
                    <article class="workout-step">
                        <div class="step-number">@item.OrderNumber</div>
                        <div>
                            <h3>
                                <a asp-controller="Exercises" asp-action="Details" asp-route-id="@item.ExerciseId">@item.ExerciseName</a>
                            </h3>
                            <p>@item.MuscleGroup · @item.Equipment</p>
                        </div>
                        <div class="step-load">
                            <strong>@item.Sets</strong>
                            <span>sets</span>
                            <strong>@item.Repetitions</strong>
                            <span>reps</span>
                        </div>
                    </article>
                }
            </div>
        </div>

        <aside class="details-side">
            <h2>Plan parameters</h2>
            <dl>
                <div>
                    <dt>Difficulty</dt>
                    <dd>@Model.Difficulty</dd>
                </div>
                <div>
                    <dt>Workout type</dt>
                    <dd>@Model.WorkoutType</dd>
                </div>
                <div>
                    <dt>Duration</dt>
                    <dd>@Model.DurationMinutes min</dd>
                </div>
                <div>
                    <dt>Exercises</dt>
                    <dd>@Model.Exercises.Count</dd>
                </div>
            </dl>
        </aside>
    </section>
</article>
