@model FitnessTrainingApp.Models.ViewModels.WorkoutComplexes.WorkoutComplexDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

<article class="exercise-details">
    <a class="back-link" asp-controller="WorkoutComplexes" asp-action="Index">Back to complexes</a>

    <header class="details-header">
        <div>
            <p class="eyebrow">@Model.WorkoutType workout</p>
            <h1>@Model.Name</h1>
            <p class="lead">@Model.Description</p>
        </div>
        <div class="details-rating">
            <span class="rating-value">@Model.DurationMinutes min</span>
            <span>@Model.Difficulty</span>
        </div>
    </header>

    <section class="details-layout">
        <div class="details-main">
            <h2>Workout sequence</h2>
            <div class="workout-steps">
                @foreach (var item in Model.Exercises)
                {
                    <article class="workout-step">
                        <div class="step-number">@item.OrderNumber</div>
                        <div>
                            <h3>
                                <a asp-controller="Exercises" asp-action="Details" asp-route-id="@item.ExerciseId">@item.ExerciseName</a>
                            </h3>
                            <p>@item.MuscleGroup · @item.Equipment</p>
                        </div>
                        <div class="step-load">
                            <strong>@item.Sets</strong>
                            <span>sets</span>
                            <strong>@item.Repetitions</strong>
                            <span>reps</span>
                        </div>
                    </article>
                }
            </div>
        </div>

        <aside class="details-side">
            <h2>Plan parameters</h2>
            <dl>
                <div>
                    <dt>Difficulty</dt>
                    <dd>@Model.Difficulty</dd>
                </div>
                <div>
                    <dt>Workout type</dt>
                    <dd>@Model.WorkoutType</dd>
                </div>
                <div>
                    <dt>Duration</dt>
                    <dd>@Model.DurationMinutes min</dd>
                </div>
                <div>
                    <dt>Exercises</dt>
                    <dd>@Model.Exercises.Count</dd>
                </div>
            </dl>
        </aside>
    </section>
</article>
