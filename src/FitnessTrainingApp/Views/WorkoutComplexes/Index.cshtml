@model IReadOnlyList<FitnessTrainingApp.Models.ViewModels.WorkoutComplexes.WorkoutComplexCardViewModel>

@{
    ViewData["Title"] = "Workout Complexes";
}

<section class="page-header">
    <div>
        <p class="eyebrow">Training plans</p>
        <h1>Workout Complexes</h1>
        <p class="lead">Choose a structured plan for home or gym training and review the exercises before starting.</p>
    </div>
</section>

<section class="catalog-summary" aria-label="Complex catalog summary">
    <span>@Model.Count complex@(Model.Count == 1 ? "" : "es") available</span>
</section>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <h2>No workout complexes found</h2>
        <p>Published training plans will appear here after moderation.</p>
    </div>
}
else
{
    <section class="exercise-grid" aria-label="Workout complex list">
        @foreach (var complex in Model)
        {
            <article class="exercise-card">
                <div class="exercise-card-meta">
                    <span>@complex.WorkoutType</span>
                    <span>@complex.Difficulty</span>
                </div>
                <h2>@complex.Name</h2>
                <p>@complex.Description</p>
                <dl>
                    <div>
                        <dt>Duration</dt>
                        <dd>@complex.DurationMinutes min</dd>
                    </div>
                    <div>
                        <dt>Exercises</dt>
                        <dd>@complex.ExerciseCount</dd>
                    </div>
                </dl>
                <a class="btn btn-outline-primary" asp-controller="WorkoutComplexes" asp-action="Details" asp-route-id="@complex.Id">View plan</a>
            </article>
        }
    </section>
}
