@model FitnessTrainingApp.Models.ViewModels.WorkoutComplexes.WorkoutComplexCatalogViewModel

@{
    ViewData["Title"] = L["Workout Complexes"];
}

<section class="page-header">
    <div>
        <p class="eyebrow">@L["Training plans"]</p>
        <h1>@L["Workout Complexes"]</h1>
        <p class="lead">@L["Choose a structured plan for home or gym training and review the exercises before starting."]</p>
    </div>
</section>

<section class="catalog-summary" aria-label="Complex catalog summary">
    <span>@L["Complexes available", Model.WorkoutComplexes.Pagination.TotalItems]</span>
</section>

@if (Model.WorkoutComplexes.Pagination.TotalItems == 0)
{
    <div class="empty-state">
        <h2>@L["No workout complexes found"]</h2>
        <p>@L["Published training plans will appear here after moderation."]</p>
    </div>
}
else
{
    <section class="exercise-grid" aria-label="Workout complex list">
        @foreach (var complex in Model.WorkoutComplexes.Items)
        {
            <article class="exercise-card">
                <div class="exercise-card-meta">
                    <span>@complex.WorkoutType</span>
                    <span>@complex.Difficulty</span>
                </div>
                <h2>@complex.Name</h2>
                <p>@complex.Description</p>
                <dl>
                    <div>
                        <dt>@L["Duration"]</dt>
                        <dd>@complex.DurationMinutes @L["min"]</dd>
                    </div>
                    <div>
                        <dt>@L["Exercises"]</dt>
                        <dd>@complex.ExerciseCount</dd>
                    </div>
                </dl>
                <a class="btn btn-outline-primary" asp-controller="WorkoutComplexes" asp-action="Details" asp-route-id="@complex.Id">@L["View plan"]</a>
            </article>
        }
    </section>

    <partial name="_Pagination" model="Model.WorkoutComplexes.Pagination" />
}
